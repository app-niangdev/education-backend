APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Racine de la SPA Angular : cible des liens ouverts par un humain (QR de verification).
FRONTEND_URL=http://localhost:4200

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cahierbi_back
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

## Messagerie temps reel (tuteurs <-> services). « reverb » branche le serveur
## WebSocket auto-heberge ; « log » desactive la diffusion sans empecher
## l'enregistrement des messages — utile en test.
BROADCAST_CONNECTION=log

## A generer par installation, ne jamais reutiliser d'un environnement a
## l'autre : ces trois valeurs signent les abonnements aux canaux prives.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

## Ce que le NAVIGATEUR compose. En production : le domaine public, 443, wss.
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

## Ce que le PROCESSUS Reverb ecoute sur la machine. Derriere Nginx, il reste
## en local : c'est le proxy qui expose le WebSocket au public.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# WAHA (WhatsApp HTTP API) : envoi des recus et factures au tuteur apres chaque
# encaissement. Laissez WAHA_BASE_URL ou WAHA_API_KEY vide pour desactiver
# l'envoi. WAHA_SESSION designe la session WhatsApp (le numero expediteur) :
# utilisez celle de l'etablissement, pas celle d'une autre application.
WAHA_BASE_URL=
WAHA_API_KEY=
WAHA_SESSION=default
WAHA_TIMEOUT=20
WAHA_COUNTRY_CODE=221

# Envoi des e-mails : codes de verification (OTP) et identifiants de premiere
# connexion. Avec `log`, rien n'est distribue — les messages atterrissent dans
# storage/logs/laravel.log, ce qui rend la double authentification inutilisable
# en production. Renseignez un vrai transporteur avant toute mise en ligne.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
